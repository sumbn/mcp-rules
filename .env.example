# Environment Variables

# ─── MCP Authentication ───────────────────────────────────────────────────────
# Bật/tắt xác thực Bearer Token cho MCP endpoint.
# MCP_AUTH_ENABLED=false  → Không yêu cầu xác thực (mặc định cho MVP)
# MCP_AUTH_ENABLED=true   → Bắt buộc Bearer Token trong mọi request
MCP_AUTH_ENABLED=false

# Token xác thực khi MCP_AUTH_ENABLED=true
# Thay thế bằng một chuỗi ngẫu nhiên mạnh (ít nhất 32 ký tự)
MCP_AUTH_TOKEN=your-secret-token-here

# ─── Server ───────────────────────────────────────────────────────────────────
# Cổng server khi chạy local (mặc định: 3000)
PORT=3000
